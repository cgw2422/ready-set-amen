{
  "name": "ready-set-amen",
  "version": "1.0.0",
  "private": true,
  "description": "Ready. Set. Amen. - the faith-first trip planner for church groups.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start -H 0.0.0.0 -p ${PORT:-3000}",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "seed": "tsx prisma/seed.ts",
    "test": "tsx --conditions=react-server --test tests/readiness.test.ts tests/auto-assign.test.ts tests/crypto.test.ts tests/waiver-content.test.ts tests/server-actions.test.ts tests/import.test.ts",
    "test:e2e": "node tests/e2e.mjs",
    "start:railway": "node scripts/railway-start.mjs",
    "seed:demo": "tsx prisma/seed.ts",
    "test:integrity": "DATABASE_URL=${TEST_DATABASE_URL:-$DATABASE_URL} APP_URL=https://waivers.test node --import tsx --conditions=react-server --test tests/waiver-integrity.test.ts",
    "test:security": "DATABASE_URL=${TEST_DATABASE_URL:-$DATABASE_URL} node --import tsx --conditions=react-server --test tests/security.test.ts",
    "test:all": "npm test && npm run test:integrity && npm run test:security && npm run test:accounts && npm run test:demo && npm run test:billing && npm run test:limits",
    "test:accounts": "DATABASE_URL=${TEST_DATABASE_URL:-$DATABASE_URL} node --import tsx --conditions=react-server --test tests/accounts.test.ts",
    "demo:status": "node --import tsx --conditions=react-server scripts/demo.ts status",
    "demo:readiness": "node --import tsx --conditions=react-server scripts/demo-readiness.ts",
    "demo:seed": "node --import tsx --conditions=react-server scripts/demo.ts seed",
    "demo:reset": "node --import tsx --conditions=react-server scripts/demo.ts reset",
    "demo:password": "node --import tsx --conditions=react-server scripts/demo.ts password",
    "grant": "node --import tsx --conditions=react-server scripts/grant.ts grant",
    "grant:status": "node --import tsx --conditions=react-server scripts/grant.ts status",
    "test:demo": "DATABASE_URL=${TEST_DATABASE_URL:-$DATABASE_URL} node --import tsx --conditions=react-server --test tests/demo.test.ts",
    "test:billing": "DATABASE_URL=${TEST_DATABASE_URL:-$DATABASE_URL} node --import tsx --conditions=react-server --test tests/billing.test.ts",
    "test:limits": "DATABASE_URL=${TEST_DATABASE_URL:-$DATABASE_URL} node --import tsx --conditions=react-server --test tests/limits.test.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.3.1",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "stripe": "^22.6.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "playwright": "^1.62.1",
    "postcss": "^8.5.1",
    "prisma": "^6.3.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.11.0"
  }
}
