# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Postgres 14+. On Railway, set this to the reference: ${{Postgres.DATABASE_URL}}
DATABASE_URL="postgresql://user:password@host:5432/readysetamen?sslmode=require"

# Public base URL. Waiver signing links are built from this, so a wrong value
# means links parents cannot open.
# On Railway you can leave it unset — the app falls back to RAILWAY_PUBLIC_DOMAIN —
# but setting it explicitly to your generated domain is clearer:
#   APP_URL="https://your-app.up.railway.app"
APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Set to "true" to rebuild the demo organization (a church, a trip, 42 people,
# a real waiver) on the next boot so you can click around immediately.
# Remove it once you've had a look — it reloads on every deploy while it's set,
# and it only ever touches the demo organization.
# SEED_DEMO_DATA="true"

# Transactional email. Entirely optional: without it, leaders share waiver
# links with Copy Link, which is the primary V1 path.
# RESEND_API_KEY=
# MAIL_FROM="Ready Set Amen <trips@example.org>"
