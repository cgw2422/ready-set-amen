# Postgres connection string (Neon, Supabase, or any Postgres 14+).
DATABASE_URL="postgresql://user:password@host:5432/readysetamen?sslmode=require"

# Public base URL — used to build waiver signing links.
APP_URL="http://localhost:3000"

# Optional. When unset, the app logs emails to the console and leaders
# use "Copy Link" instead. Ready Set Amen is fully functional without it.
# RESEND_API_KEY=
# MAIL_FROM="Ready Set Amen <trips@example.org>"
